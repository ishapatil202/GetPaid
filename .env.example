# Copy this file to .env and fill in your own values.
# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Email of your sandbox PERSONAL account (Testing Tools -> Sandbox Accounts)
PAYPAL_BUYER_EMAIL=

# AI (platform.openai.com -> API keys)
OPENAI_API_KEY=
# Optional backup / comparison (platform.claude.com -> API keys)
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# App
SECRET_KEY=change-me-to-any-long-random-text
PAYPAL_ENV=sandbox
# Leave empty locally (uses SQLite). Render sets this to PostgreSQL.
DATABASE_URL=
FRONTEND_ORIGINS=http://localhost:5173
